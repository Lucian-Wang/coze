# ======================
# 服务端口与回调路径
# ======================
WEBHOOK_PORT=5001
QIWEAPI_CALLBACK_PATH=/qiweapi/callback

# 后台线程池（处理 webhook 的重任务：Coze/Ark/下载上传/ASR）
TASK_THREADPOOL_SIZE=8
MARKETING_ARK_WORKERS=4
# ======================
# Webhook 入站鉴权（query token）
# 访问示例：
# http://你的服务器:5001/qiweapi/callback?token=xxxxxxx
# ======================
WEBHOOK_AUTH_TOKEN=
WEBHOOK_AUTH_MODE=query
WEBHOOK_AUTH_QUERY=token

# ======================
# 管理后台账号密码（BasicAuth）
# ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ======================
# SQLite
# ======================
SQLITE_DB_PATH=data/app.db

# ======================
# qiweapi（必填）
# ======================
QIWE_API_BASE_URL=http://manager.qiweapi.com/qiwe
QIWE_API_TOKEN=
QIWE_API_GUID=

QIWE_SEND_TIMEOUT=10
QIWE_UPLOAD_TIMEOUT=30
QIWE_DOWNLOAD_TIMEOUT=30

# 下载方法（按你的 qiweapi 实际情况）
QIWE_METHOD_WX_DOWNLOAD=/cloud/wxDownload
QIWE_METHOD_WXWORK_DOWNLOAD=/cloud/wxWorkDownload

# 上传方法（doFileApi）
QIWE_DOFILE_METHOD=/cloud/cdnBigUpload
QIWE_IMAGE_FILETYPE_UPLOAD=1

# 处理 Coze 回复图片 URL → 下载并上传发送
DIRECT_DOWNLOAD_TIMEOUT=30
MAX_FILE_BYTES=20971520
SEND_IMAGE_FROM_COZE_REPLY=1
SEND_TEXT_AFTER_IMAGE=1

# ======================
# Scheduler
SCHEDULER_LOCK_PATH=/tmp/qiwe-bot.scheduler.lock
# 推荐：开发/测试 60；生产可调为 300
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_DEBUG=0

# ---- 沉默运营 / 决策相关 ----
MARKETING_ENABLED=1
OPT_IN_DEFAULT=1
# 用户静默多少分钟后触发 Ark 决策（你想要的行为）
DECISION_IDLE_MINUTES=10

# 免打扰时段
QUIET_HOURS_ENABLED=1
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
QUIET_HOURS_DEFER_MINUTES=5

# 当日最多跟进次数（你的策略建议 2）
DAILY_FOLLOWUP_LIMIT=2

# 上次 outbound 与下次发送的最小间隔（分钟）
MIN_FOLLOWUP_INTERVAL_MINUTES=5

# 达到成交置信度标记为 won 的阈值
WON_THRESHOLD=0.90

MAX_MESSAGES_FOR_DECISION=80
MAX_DAYS_FOR_DECISION=14
NEXT_DECISION_COOLDOWN_MINUTES_DEFAULT=5

# 超过多少天无用户回复则标记为 lost（你提出 3 天）
MARKETING_MARK_LOST_AFTER_DAYS=3


# ======================
# Coze（实时回复 + 跟进文案生成）
# ======================
COZE_STREAM_RUN_URL=https://xxx.coze.site/stream_run
COZE_TOKEN=
COZE_PROJECT_ID=
COZE_SESSION_ID_PREFIX=session_
COZE_TIMEOUT=60

# ======================
# Ark（必填：用于 OCR + 沉默决策画像）
# ======================
ARK_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_BEARER=
ARK_TIMEOUT=60

# 图片 OCR/视觉模型
ARK_VISION_MODEL=doubao-seed-1-6-vision-250815
ARK_MAX_CHARS=2500

# 文本决策模型
ARK_DECISION_MODEL=doubao-seed-2-0-pro-260215

# ======================
# Doubao / Volc 录音文件识别（AUC BigModel ASR）——默认使用模型 2.0
# 语音链路：企微语音(AMR)→qiwe 下载得到 cloudUrl → 本地转码 wav → 上传到自建上传接口
# → submit/query ASR(format=wav) → 得到 text → 走 Coze
# ======================
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc

DOUBAO_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
DOUBAO_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query

DOUBAO_ASR_MODEL_NAME=bigmodel
DOUBAO_ASR_AUDIO_FORMAT=wav
DOUBAO_ASR_AUDIO_LANGUAGE=

DOUBAO_ASR_HTTP_TIMEOUT=30
DOUBAO_ASR_POLL_INTERVAL=1
DOUBAO_ASR_MAX_POLL_SECONDS=60

# ======================
# 火山 TOS 音频上传配置
# ======================
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_REGION=cn-beijing
TOS_URL_EXPIRE_HOURS=1

# kn007/silk-v3-decoder 编译出来的 decoder
SILK_DECODER_BIN=/opt/silk-v3-decoder/silk/decoder
SILK_PCM_SAMPLE_RATE=24000

# ffmpeg（你机器是 /usr/bin/ffmpeg；如果 gunicorn PATH 不稳就显式写）
FFMPEG_BIN=/usr/bin/ffmpeg


# 是否保存 ASR/OCR 派生文本（推荐默认开启）
STORE_DERIVED_TEXT=1

# 是否只保存 OCR 脱敏摘要（推荐默认启；如果以后要存逐字OCR原文，再把它改成0）
STORE_OCR_SUMMARY_ONLY=1

# 是否在入库 extra_json 里保存上传后的 wav_url（默认=1）
STORE_AUDIO_URL=1

# 开启“长文本分段发送”
QIWE_SPLIT_LONG_TEXT_ENABLED=1
# 每段最大字数（120~180 之间都行）
QIWE_SPLIT_MAX_CHARS_PER_MSG=140
# 最多拆几段，防刷屏
QIWE_SPLIT_MAX_PARTS=3

# 开启 1~3分钟随机延迟（建议先只对首段启用，否则拆成多段会拖得太久）
QIWE_HUMAN_LONG_DELAY_ENABLED=0
QIWE_HUMAN_LONG_DELAY_MIN_SEC=10
QIWE_HUMAN_LONG_DELAY_MAX_SEC=30
QIWE_HUMAN_LONG_DELAY_FIRST_PART_ONLY=1

# 仍保留“打字延迟”（可小一点）
QIWE_HUMAN_DELAY_ENABLED=1
QIWE_HUMAN_DELAY_BASE_MS=150
QIWE_HUMAN_DELAY_PER_CHAR_MS=5
QIWE_HUMAN_DELAY_JITTER_MS=100
QIWE_HUMAN_DELAY_MAX_MS=800


# ======================
# 日志
# ======================
MASK_SECRETS_IN_LOGS=1
QIWE_HUMAN_DELAY_IMAGE_BONUS_MS=50
QIWE_FIRST_MESSAGE_DELAY_MS=0