[Unit]
Description=Qiwe Bot Service
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/qiwe-bot
Environment=PATH=/www/wwwroot/qiwe-bot/venv/bin
ExecStart=/www/wwwroot/qiwe-bot/venv/bin/gunicorn -c gunicorn_conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
